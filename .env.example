# Salin file ini ke .env dan isi dengan nilai yang benar
# Di Vercel: tambahkan environment variables ini di dashboard Settings > Environment Variables

# Wajib: API key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Opsional: model default (jika tidak diisi, pakai gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# Hanya untuk development lokal (tidak dibutuhkan di Vercel)
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
